generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Priority {
  HIGH @map("high")
  MEDIUM @map("medium")
  LOW @map("low")
}

enum Status {
  COMPLETED @map("completed")
  NEXT @map("next")
}

model Task {
  id Int @id @default(autoincrement())
  publicId String @unique @default(uuid())

  title String @unique
  description String
  deadline DateTime

  priority Priority @default(MEDIUM)
  status Status @default(NEXT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tasks")
}

model Appointment {
  id Int @id @default(autoincrement())
  publicId String @unique @default(uuid())
  
  title String @unique
  description String
  date DateTime
  local String?

  status Status @default(NEXT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("appointments")
}

model SubjectAbsence {
  id Int @id @default(autoincrement())
  publicId String @unique @default(uuid())

  subject String @unique
  absences Int @default(0) @map("absences")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subjects_absences")
}